{
  "name": "@axon-memory/sdk",
  "version": "1.0.0",
  "description": "TypeScript client for the AXON Memory v1 API: capture, recall, supersede, retire, restore, delete.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
